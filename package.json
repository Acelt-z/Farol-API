{
  "name": "farol-api",
  "version": "1.0.0",
  "description": "API do ERP do Farol",
  "main": "dist/index.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "dev": "npm run serve",
    "start:prod": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Farol-das-Financas/Farol-API.git"
  },
  "author": "Farol das Finanças",
  "license": "ISC",
  "engines": {
    "node": "22"
  },
  "bugs": {
    "url": "https://github.com/Farol-das-Financas/Farol-API/issues"
  },
  "homepage": "https://github.com/Farol-das-Financas/Farol-API#readme",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@supabase/supabase-js": "^2.97.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator-brazil": "^1.2.2",
    "winston": "^3.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yaml": "^1.9.6",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
